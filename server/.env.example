PORT=3001
MONGODB_URI=sua_string_de_conexão_mongodb_aqui
JWT_SECRET=seu_segredo_jwt_randomico_32_caracteres_ou_mais
JWT_EXPIRE=30d

# Configurações Cloudinary (Avatar Uploads)
CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
CLOUDINARY_API_KEY=sua_api_key_cloudinary_aqui
CLOUDINARY_API_SECRET=seu_api_secret_cloudinary_aqui

# Configuração Murphy AI (Google Gemini)
# Obtido em: https://aistudio.google.com/
GEMINI_API_KEY=sua_google_gemini_api_key_aqui

# Configuração de E-mail (Exemplo Gmail SMTP)
# Para Gmail, use uma "Senha de App" (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_gmail@gmail.com
SMTP_PASS=sua_senha_de_app_gmail_aqui

# URL do Frontend (Para CORS e e-mails)
FRONTEND_URL=http://localhost:3000

# Opcional: Configuração SendGrid (Se preferir usar no lugar do SMTP puro)
SENDGRID_API_KEY=sua_api_key_sendgrid_aqui
SENDGRID_FROM_EMAIL=seu_email_verificado_aqui
SENDGRID_FROM_NAME="Onde Tá Passando?"
USE_SENDGRID=false
